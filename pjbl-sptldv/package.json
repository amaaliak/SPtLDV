{
  "name": "pjbl-sptldv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Platform Pembelajaran Berbasis Proyek (PjBL) untuk materi Sistem Pertidaksamaan Linear Dua Variabel — SMK Tata Boga",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node dev/server.mjs",
    "dev:cf": "wrangler pages dev --port 8788",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "db:local": "wrangler d1 execute pjbl-sptldv-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute pjbl-sptldv-db --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:worker": "npm run build && wrangler deploy -c wrangler.worker.toml",
    "db:seed": "node dev/seed.mjs",
    "db:reset": "node dev/seed.mjs --kosong"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@hono/node-server": "^1.13.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  }
}